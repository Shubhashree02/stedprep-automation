
        <!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="StedPrep Automation Suite">

<test name="Full Flow Tests">
    <classes>

        <!-- 1️⃣ Parent Registration (creates parent + student creds) -->
        <class name="com.stedprep.automation.tests.ParentRegistrationTest"/>

        <!-- 2️⃣ Student Login (uses stored creds) -->
        <class name="com.stedprep.automation.tests.StudentLoginTest"/>

        <!-- 3️⃣ Diagnostic Automation -->
        <class name="com.stedprep.automation.tests.DiagnosticTest"/>

    </classes>
</test>

<test name="Forgot Password Tests">
    <classes>
        <!-- Forgot Password Flow -->
        <class name="com.stedprep.automation.tests.ForgotPasswordTest"/>
    </classes>
</test>

</suite>
